# Chave usada para assinar os tokens JWT.
# Em produção, utilize uma chave longa, aleatória e secreta.
SECRET_KEY=troque-esta-chave-por-uma-chave-forte

# Tempo de validade do token em minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Usuário administrador criado automaticamente no primeiro uso.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=troque-esta-senha
